+    }
+
+    #[getter]
+    fn reason(&self) -> i32 {
+        self.e.reason
+    }
+
+    #[getter]
+    fn reason_text(&self) -> &[u8] {
+        self.e.reason_text.as_bytes()
+    }
+}
